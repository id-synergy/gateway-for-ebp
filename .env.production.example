# Exemple de configuration PRODUCTION
# Copier en .env sur le serveur et remplir les valeurs. NE PAS committer le .env réel.

APP_NAME="Gateway EBP"
APP_ENV=production
APP_KEY=                      # php artisan key:generate (À SAUVEGARDER : chiffre les secrets EBP)
APP_DEBUG=false
APP_URL=https://gateway.example.com

# --- Base de données ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ebp_gateway
DB_USERNAME=
DB_PASSWORD=

# --- Redis (files Horizon + verrous + régulateur de quota) ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Partagés via Redis en prod : indispensable pour que quota et verrous soient GLOBAUX.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# --- Mail (alertes admin) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="gateway@example.com"
MAIL_FROM_NAME="Gateway EBP"

# --- EBP (endpoints ; les secrets par compte sont en base chiffrée, PAS ici) ---
EBP_REDIRECT_URI=https://gateway.example.com/oauth/ebp/callback
# redirect_uri « localhost » whitelisté d'origine chez EBP (avant validation de votre domaine).
# Utilisé par les comptes en mode de redirection « Localhost EBP » (avec saisie manuelle du retour).
EBP_LOCALHOST_REDIRECT=http://localhost:3333/callback
EBP_AUTHORIZE_URL=https://api-login.ebp.com/connect/authorize/callback
EBP_TOKEN_URL=https://api-login.ebp.com/connect/token
EBP_API_BASE_URL=https://api-developpeurs.ebp.com
# Préfixes EBP relayés par le proxy (séparés par des virgules). Les 7 modules sont actifs par
# défaut ; ne gardez ici que ceux auxquels vous êtes abonné pour restreindre la surface relayée.
EBP_PROXY_PREFIXES=gescom/api/v1,hubbix-gctpe/api/public/v1,hubbix-cpttpe/api/v1,batiment/api/v1,import/api/v1,export/api/v1,maintenance/api/v1
# Faux portail EBP (dev/test uniquement). NE JAMAIS activer en production : la config
# le force à false si APP_ENV=production, mais laissez-le à false par sécurité.
EBP_FAKE_PORTAL=false

# --- Réglages gateway ---
GATEWAY_QUEUE_SWITCH_THRESHOLD=10
GATEWAY_SYNC_TIMEOUT=120
GATEWAY_POLL_INTERVAL_HINT=3
GATEWAY_RATE_LIMIT_PER_MIN=30
GATEWAY_LOG_RETENTION_DAYS=360
GATEWAY_JOB_RESULT_RETENTION_DAYS=360
GATEWAY_ENFORCE_2FA=true
GATEWAY_ALERT_FALLBACK_EMAIL=
