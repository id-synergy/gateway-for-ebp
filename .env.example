APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Fuseau horaire de l'application : horodatage des logs et des dates renvoyées.
# Défaut UTC (neutre). Mettre le fuseau local de l'installation, ex. Europe/Paris.
APP_TIMEZONE=UTC

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Gateway EBP ---
EBP_REDIRECT_URI=https://gateway.example.com/oauth/ebp/callback
EBP_AUTHORIZE_URL=https://api-login.ebp.com/connect/authorize/callback
EBP_TOKEN_URL=https://api-login.ebp.com/connect/token
EBP_API_BASE_URL=https://api-developpeurs.ebp.com
GATEWAY_QUEUE_SWITCH_THRESHOLD=10
GATEWAY_SYNC_TIMEOUT=120
GATEWAY_POLL_INTERVAL_HINT=3
GATEWAY_RATE_LIMIT_PER_MIN=30
GATEWAY_LOG_RETENTION_DAYS=360
GATEWAY_JOB_RESULT_RETENTION_DAYS=360
GATEWAY_ALERT_FALLBACK_EMAIL=
