# =============================================================================
# Configuration Docker de PRODUCTION — gateway-for-ebp.
#
#   cp .env.docker.example .env
#   # éditer les valeurs ci-dessous (au minimum DB_PASSWORD et APP_URL)
#   docker compose -f compose.prod.yaml up -d --build
#
# APP_KEY est laissée VIDE : elle est générée au 1er démarrage et écrite ici
# même (ce fichier est monté dans le conteneur). NE PAS committer votre .env.
# =============================================================================

APP_NAME="Gateway EBP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gateway.example.com

# --- Base de données (service `mysql` du compose) ----------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ebp_gateway
DB_USERNAME=gateway
DB_PASSWORD=change-me
# Mot de passe root MySQL (défaut = DB_PASSWORD si non renseigné).
DB_ROOT_PASSWORD=

# --- Redis (service `redis` du compose : cache + queue + verrous + quota) -----
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Partagés via Redis : indispensable pour que quota et verrous soient GLOBAUX.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# --- Mail (alertes admin) ----------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="gateway@example.com"
MAIL_FROM_NAME="Gateway EBP"

# --- EBP (endpoints ; les secrets par compte sont saisis au back-office et
#     stockés chiffrés en base — PAS ici) --------------------------------------
EBP_REDIRECT_URI=https://gateway.example.com/oauth/ebp/callback
EBP_LOCALHOST_REDIRECT=http://localhost:3333/callback
EBP_AUTHORIZE_URL=https://api-login.ebp.com/connect/authorize
EBP_TOKEN_URL=https://api-login.ebp.com/connect/token
EBP_API_BASE_URL=https://api-developpeurs.ebp.com
EBP_PROXY_PREFIXES=gescom/api/v1,hubbix-gctpe/api/public/v1,hubbix-cpttpe/api/v1,batiment/api/v1,import/api/v1,export/api/v1,maintenance/api/v1
# Faux portail EBP : TOUJOURS false en production.
EBP_FAKE_PORTAL=false

# --- Réglages gateway --------------------------------------------------------
GATEWAY_QUEUE_SWITCH_THRESHOLD=10
GATEWAY_SYNC_TIMEOUT=120
GATEWAY_POLL_INTERVAL_HINT=3
GATEWAY_RATE_LIMIT_PER_MIN=30
GATEWAY_LOG_RETENTION_DAYS=360
GATEWAY_JOB_RESULT_RETENTION_DAYS=360
GATEWAY_ENFORCE_2FA=true
GATEWAY_ALERT_FALLBACK_EMAIL=

# --- Supervision -------------------------------------------------------------
# Jeton pour le détail de /healthcheck (sinon statut global ok/ko seulement).
HEALTHCHECK_TOKEN=
